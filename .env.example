# Kontaktformular-Versand über Resend (https://resend.com)
# 1. Kostenloses Konto bei resend.com anlegen
# 2. Unter "API Keys" einen neuen Key erstellen und hier eintragen
# 3. Datei als .env.local speichern (ohne .example), Server neu starten
RESEND_API_KEY=

# Optional: eigene Absenderadresse, sobald eine Domain bei Resend
# verifiziert ist (z.B. "Artur Butsch <kontakt@abutsch.de>").
# Ohne verifizierte Domain bleibt es bei der Resend-Testadresse.
RESEND_FROM_EMAIL=

# Optional: Zieladresse für eingehende Kontaktanfragen, falls sie von der
# öffentlich angezeigten E-Mail (siteConfig.email) abweichen soll.
CONTACT_FORM_TO_EMAIL=
